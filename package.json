{
  "name": "aurora-filtech",
  "version": "1.0.0",
  "scripts": {
    "build": "node design_light/src/build.js",
    "watch:ejs": "browser-sync start --server design_light --files \"design_light/**/*.*\" --ignore \"design_light/src/**/*.*\"",
    "watch:build": "node design_light/src/build.js --watch",
    "watch:cms": "npx decap-server",
    "start": "npm-run-all build --parallel watch:*"
  },
  "devDependencies": {
    "browser-sync": "^3.0.2",
    "decap-server": "^3.6.0",
    "ejs": "^3.1.10",
    "gray-matter": "^4.0.3",
    "marked": "^17.0.5",
    "npm-run-all": "^4.1.5"
  }
}
