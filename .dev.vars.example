# Copy to .dev.vars for local API tests; it is ignored by Git.
SMTP_HOST="smtp.qiye.aliyun.com"
SMTP_PORT="465"
SMTP_USER="johnson@aurora-filtech.com"
# Use a third-party client security password; fill it only in .dev.vars or Cloudflare Secrets.
SMTP_PASSWORD=
# Must match SMTP_USER. A dedicated same-domain account can be used instead.
RFQ_FROM_EMAIL="johnson@aurora-filtech.com"
RFQ_TO_EMAIL="johnson@aurora-filtech.com"
# Optional bot protection. Configure both values together.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
