<!DOCTYPE html>
<html lang="en">
<head>
<%- include('../partials/head', { title: 'Product Catalog', description: 'Explore Aurora Filtech\'s complete range of industrial filtration solutions, including filter press cloth, filter bags, belts, and fibers.', path: '/products.html' }) %>
</head>
<body>
    <%- include('../partials/header', { path: '/products.html' }) %>

    <section class="hero" style="padding: 80px 0; text-align: center; background: linear-gradient(135deg, var(--bg-surface), var(--border-color));">
        <div class="container">
            <h1 style="font-size: 3rem; margin-bottom: 20px;">Product Catalog</h1>
            <p style="margin: 0 auto; max-width: 600px; color: var(--text-muted);">Explore our complete range of industrial filtration solutions.</p>
        </div>
    </section>

    <!-- Filter Control Section -->
    <div class="filter-container">
        <div class="container">
            <div class="filter-wrapper">
                <button class="filter-btn active" onclick="filterSelection('all')">All Products</button>
                <button class="filter-btn" onclick="filterSelection('featured')">Featured Products</button>
                <button class="filter-btn" onclick="filterSelection('cloth')">Filter Press Cloth</button>
                <button class="filter-btn" onclick="filterSelection('bags')">Filter Bags</button>
                <button class="filter-btn" onclick="filterSelection('belts')">Other Belts</button>
                <button class="filter-btn" onclick="filterSelection('fibers')">Fibers</button>
            </div>
        </div>
    </div>

    <section class="section">
        <div class="container">
            <div class="products-grid">
                
                <!-- Dynamic Products from CMS -->
                <% if (typeof products !== 'undefined' && products.length > 0) { %>
                    <% products.forEach(function(product) { %>
                        <div class="product-card filter-item" data-category="cms">
                            <% if (product.image) { %>
                                <div style="height: 200px; background-image: url('<%= product.image %>'); background-size: cover; background-position: center; border-radius: 12px 12px 0 0;"></div>
                            <% } %>
                            <div class="product-info">
                                <span class="subtitle" style="font-size: 0.8rem; margin-bottom: 5px; color: var(--primary-color);">CMS Managed</span>
                                <h3><%= product.title %></h3>
                                <p><%= product.description %></p>
                            </div>
                        </div>
                    <% }); %>
                <% } %>

                <!-- Featured Items (Dryer & Vacuum Fabric) -->
                <a href="dryer-fabric.html" class="product-card filter-item" data-category="featured" style="display: block; border-top: 4px solid var(--accent-color);">
                    <div style="height: 200px; background-image: url('assets/hero_bg.png'); background-size: cover; background-position: center; border-radius: 12px 12px 0 0;"></div>
                    <div class="product-info" style="padding: 20px;">
                        <span class="subtitle" style="font-size: 0.8rem; margin-bottom: 5px; color: var(--primary-color);">Featured Product</span>
                        <h3 style="color: var(--text-color); margin-bottom: 10px; font-size: 1.3rem;">Dryer Fabric</h3>
                        <p style="color: var(--text-muted); line-height: 1.6; margin-bottom: 0;">Anti-static dryer fabric, mesh belts, and nonwoven dryer belts with high-temperature resistance.</p>
                    </div>
                </a>

                <a href="vacuum-fabric.html" class="product-card filter-item" data-category="featured" style="display: block; border-top: 4px solid var(--accent-color);">
                    <div style="height: 200px; background-image: url('assets/hero_bg.png'); background-size: cover; background-position: center; border-radius: 12px 12px 0 0;"></div>
                    <div class="product-info" style="padding: 20px;">
                        <span class="subtitle" style="font-size: 0.8rem; margin-bottom: 5px; color: var(--primary-color);">Featured Product</span>
                        <h3 style="color: var(--text-color); margin-bottom: 10px; font-size: 1.3rem;">Vacuum Fabric</h3>
                        <p style="color: var(--text-muted); line-height: 1.6; margin-bottom: 0;">Vacuum filter fabric, FGD fabric, and chemical industry filtration solutions for optimal particle retention.</p>
                    </div>
                </a>

                <!-- Filter Cloth Items -->
                <div class="product-card filter-item" data-category="cloth">
                    <div class="product-info">
                        <span class="subtitle" style="font-size: 0.8rem; margin-bottom: 5px; color: var(--primary-color);">Filter Cloth</span>
                        <h3>Mono × Mono Filter Cloth</h3>
                        <p>Delivers outstanding filtration results with smooth surfaces. Easy to clean and does not clog.</p>
                    </div>
                </div>

                <div class="product-card filter-item" data-category="cloth">
                    <div class="product-info">
                        <span class="subtitle" style="font-size: 0.8rem; margin-bottom: 5px; color: var(--primary-color);">Filter Cloth</span>
                        <h3>Multi × Multi Filter Cloth</h3>
                        <p>Known for retaining very fine particles and high mechanical resistance.</p>
                    </div>
                </div>

                <div class="product-card filter-item" data-category="cloth">
                    <div class="product-info">
                        <span class="subtitle" style="font-size: 0.8rem; margin-bottom: 5px; color: var(--primary-color);">Filter Cloth</span>
                        <h3>Anti-Static Filter Cloth</h3>
                        <p>Specialized fabric for safe operation in explosive environments (PET, PA, PP).</p>
                    </div>
                </div>

                <!-- Filter Bags Items -->
                <div class="product-card filter-item" data-category="bags">
                    <div class="product-info">
                        <span class="subtitle" style="font-size: 0.8rem; margin-bottom: 5px; color: var(--primary-color);">Filter Bags</span>
                        <h3>High-Temp Filter Bags</h3>
                        <p>P84, PTFE, and NOMEX materials resisting temperatures up to 260°C+.</p>
                    </div>
                </div>

                <div class="product-card filter-item" data-category="bags">
                    <div class="product-info">
                        <span class="subtitle" style="font-size: 0.8rem; margin-bottom: 5px; color: var(--primary-color);">Filter Bags</span>
                        <h3>Chemical Resistant Bags</h3>
                        <p>PPS and PTFE bags offering superior acid and alkali resistance.</p>
                    </div>
                </div>

                <div class="product-card filter-item" data-category="bags">
                    <div class="product-info">
                        <span class="subtitle" style="font-size: 0.8rem; margin-bottom: 5px; color: var(--primary-color);">Filter Bags</span>
                        <h3>Liquid Filter Bags</h3>
                        <p>Micron-rated bags (PP, PE, Nylon) with high dirt-holding capacity.</p>
                    </div>
                </div>

                <!-- Belts Items -->
                <div class="product-card filter-item" data-category="belts">
                    <div class="product-info">
                        <span class="subtitle" style="font-size: 0.8rem; margin-bottom: 5px; color: var(--primary-color);">Belts</span>
                        <h3>Nonwoven Dryer Fabrics</h3>
                        <p>High-resistance belts (180-260°C) with excellent airflow.</p>
                    </div>
                </div>

                <div class="product-card filter-item" data-category="belts">
                    <div class="product-info">
                        <span class="subtitle" style="font-size: 0.8rem; margin-bottom: 5px; color: var(--primary-color);">Belts</span>
                        <h3>Forming Fabrics</h3>
                        <p>Unique weave structures that resist high pressure. Optimum drainage.</p>
                    </div>
                </div>

                <div class="product-card filter-item" data-category="belts">
                    <div class="product-info">
                        <span class="subtitle" style="font-size: 0.8rem; margin-bottom: 5px; color: var(--primary-color);">Belts</span>
                        <h3>Vacuum Filter Belts</h3>
                        <p>Heavy-duty belts for FGD and mining tailings dewatering.</p>
                    </div>
                </div>

                <!-- Fibers Items -->
                <div class="product-card filter-item" data-category="fibers">
                    <div class="product-info">
                        <span class="subtitle" style="font-size: 0.8rem; margin-bottom: 5px; color: var(--primary-color);">Fibers</span>
                        <h3>PEEK Monofilament</h3>
                        <p>High mechanical/chemical resistance for medical and aerospace use.</p>
                    </div>
                </div>

                <div class="product-card filter-item" data-category="fibers">
                    <div class="product-info">
                        <span class="subtitle" style="font-size: 0.8rem; margin-bottom: 5px; color: var(--primary-color);">Fibers</span>
                        <h3>PPS Monofilament</h3>
                        <p>Excellent chemical resistance, stable up to 240°C.</p>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <%- include('../partials/footer') %>

    <script>
        function filterSelection(c) {
            var x, i;
            x = document.getElementsByClassName("filter-item");
            var btns = document.getElementsByClassName("filter-btn");
            
            for (var b = 0; b < btns.length; b++) {
                btns[b].classList.remove("active");
                if (btns[b].getAttribute("onclick").includes("'" + c + "'")) {
                    btns[b].classList.add("active");
                }
            }

            if (c == "all") c = "";
            for (i = 0; i < x.length; i++) {
                var itemCat = x[i].getAttribute("data-category");
                if (itemCat === c || c === "") {
                    x[i].style.display = "flex"; 
                } else {
                    x[i].style.display = "none";
                }
            }
        }
        // Initialize
        filterSelection('all');
    </script>
</body>
</html>
