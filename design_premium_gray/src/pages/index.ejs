<!DOCTYPE html>
<html lang="en">
<head>
<%- include('../partials/head', { title: 'filter fabric, dryer fabric, spiral belt, press filter fabric, ventilation belt,pre-press belt, forming fabric', description: 'Aurora Filtech specializes in advanced industrial filter fabrics, dryer belts, forming fabrics, and spiral belts for paper, nonwoven, mining, and food industries.', path: '/' }) %>
</head>
<body>
    <%- include('../partials/header', { path: '/' }) %>

    <!-- Hero Section -->
    <section class="hero">
        <div class="hero-content">
            <h1 style="font-size: 4rem;">Precision Engineered Filtration.</h1>
            <p>Experience the next generation of industrial filter media. Designed for extreme durability, maximum efficiency, and zero compromise.</p>
            <div style="display: flex; gap: 15px; justify-content: center; flex-wrap: wrap;">
                <a href="#products" class="btn">Explore Solutions</a>
                <a href="contact.html" class="btn btn-outline">Get a Quote</a>
            </div>
        </div>
        <div class="hero-visual" style="background-image: url('assets/live_img_1.jpg');" role="img" aria-label="High quality industrial filter fabric">
            <!-- Floating Stats -->
            <div style="position: absolute; bottom: 30px; left: 30px; background: rgba(255, 255, 255, 0.85); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); padding: 16px 24px; border-radius: 20px; border: 1px solid rgba(0, 0, 0, 0.08); text-align: center; box-shadow: 0 10px 30px rgba(0,0,0,0.05); display: flex; gap: 30px;">
                <div>
                    <div style="font-size: 1.5rem; font-weight: 700; color: var(--primary-color);">30+</div>
                    <div style="font-size: 0.9rem; color: var(--text-main); font-weight: 500;">Years Exp</div>
                </div>
                <div style="width: 1px; background: var(--border-color);"></div>
                <div>
                    <div style="font-size: 1.5rem; font-weight: 700; color: var(--primary-color);">3</div>
                    <div style="font-size: 0.9rem; color: var(--text-main); font-weight: 500;">Factories</div>
                </div>
                <div style="width: 1px; background: var(--border-color);"></div>
                <div>
                    <div style="font-size: 1.5rem; font-weight: 700; color: var(--primary-color);"><i class="fas fa-globe"></i></div>
                    <div style="font-size: 0.9rem; color: var(--text-main); font-weight: 500;">Global Standards</div>
                </div>
            </div>
        </div>
    </section>

    <!-- Why Choose Us Section -->
    <section class="section" style="background-color: var(--bg-surface); padding: 80px 0;">
        <div class="container" style="text-align: center; max-width: 800px;">
            <h2 style="font-size: 2.5rem; margin-bottom: 24px;">Why Choose Us</h2>
            <p style="font-size: 1.1rem; color: var(--text-main); line-height: 1.8;">
                Aurora Filtech combine 30+ years of expertise with advanced German technology to deliver filtration media that lasts longer and performs better. From proprietary monofilament production to automated joint, we control every step of the process. We also provide OEM/ODM service to help you to develop your local business.
            </p>
        </div>
    </section>

    <!-- Products Section -->
    <section id="products" class="section" style="scroll-margin-top: 100px;">
        <div class="container">
            <div class="section-header" style="text-align: center; margin-bottom: 50px;">
                <h2 style="font-size: 3rem;">Our Solutions</h2>
                <p style="max-width: 600px; margin: 0 auto;">Comprehensive filtration media for diverse industrial applications.</p>
            </div>
            
            <div class="bento-grid">
                <!-- Product 1 (Large) -->
                <a href="products.html" class="product-card" style="grid-column: span 2; grid-row: span 2;">
                    <img class="product-card-img" style="height: 300px;" src="assets/live_img_2.jpg" alt="Paper Mills, Belt conveyor, Non-woven Fabric Forming Machine" loading="lazy">
                    <h3 style="font-size: 1.8rem; margin-bottom: 16px;">Forming Fabric</h3>
                    <div style="display: flex; gap: 20px; flex-wrap: wrap;">
                        <div style="flex: 1; min-width: 200px;">
                            <div style="font-weight: 600; margin-bottom: 8px;">Used in:</div>
                            <ul>
                                <li>Paper Mills</li>
                                <li>Belt conveyor</li>
                                <li>Non-woven Fabric Forming Machine</li>
                            </ul>
                        </div>
                        <div style="flex: 1; min-width: 200px;">
                            <div style="font-weight: 600; margin-bottom: 8px; color: var(--primary-color);">Applications:</div>
                            <ul style="list-style-type: circle; padding-left: 20px;">
                                <li style="display: list-item;">Nonwoven fabric forming</li>
                                <li style="display: list-item;">Paper forming</li>
                                <li style="display: list-item;">Graphite flake forming</li>
                            </ul>
                        </div>
                    </div>
                </a>

                <!-- Product 2 -->
                <a href="products.html" class="product-card">
                    <img class="product-card-img" src="assets/live_img_3.jpg" alt="Board forming machine, Food drying machine, Belt dring machine" loading="lazy">
                    <h4>Dryer Fabric & Mesh Belt</h4>
                    <ul>
                        <li>Board forming machine</li>
                        <li>Food drying machine</li>
                    </ul>
                    <div style="border-top: 1px solid var(--border-color); padding-top: 12px; margin-top: auto;">
                        <div style="font-size: 0.85rem; font-weight: 600; color: var(--primary-color); margin-bottom: 8px;">Applications:</div>
                        <ul style="margin: 0; padding-left: 15px; list-style-type: circle;">
                            <li style="font-size: 0.85rem; display: list-item;">Wood panel board forming</li>
                            <li style="font-size: 0.85rem; display: list-item;">Paper / Food drying</li>
                        </ul>
                    </div>
                </a>

                <!-- Product 3 -->
                <a href="products.html" class="product-card">
                    <img class="product-card-img" src="assets/live_img_4.jpg" alt="Vacuum belt filter, Vacuum disc filter" loading="lazy">
                    <h4>Vacuum Filter Fabric</h4>
                    <ul>
                        <li>Vacuum belt filter</li>
                        <li>Vacuum disc filter</li>
                    </ul>
                    <div style="border-top: 1px solid var(--border-color); padding-top: 12px; margin-top: auto;">
                        <div style="font-size: 0.85rem; font-weight: 600; color: var(--primary-color); margin-bottom: 8px;">Applications:</div>
                        <ul style="margin: 0; padding-left: 15px; list-style-type: circle;">
                            <li style="font-size: 0.85rem; display: list-item;">Power plant FGD</li>
                            <li style="font-size: 0.85rem; display: list-item;">Mining / Phosphoric acid</li>
                        </ul>
                    </div>
                </a>

                <!-- Product 4 (Wide) -->
                <a href="products.html" class="product-card" style="grid-column: span 2;">
                    <div style="display: flex; gap: 24px; height: 100%;">
                        <div style="flex: 1;">
                            <h3 style="font-size: 1.5rem; margin-bottom: 16px;">Press Filter Cloth</h3>
                            <ul style="margin-bottom: 16px;">
                                <li>Frame press filter</li>
                                <li>Mambrane press filter</li>
                                <li>Drum / Disc / Leaf filter</li>
                            </ul>
                            <div style="font-size: 0.85rem; font-weight: 600; color: var(--primary-color); margin-bottom: 8px;">Applications:</div>
                            <ul style="margin: 0; padding-left: 15px; list-style-type: circle; columns: 2;">
                                <li style="font-size: 0.85rem; display: list-item;">Oil filtration</li>
                                <li style="font-size: 0.85rem; display: list-item;">Mining filtration</li>
                                <li style="font-size: 0.85rem; display: list-item;">Lithium phosphate</li>
                                <li style="font-size: 0.85rem; display: list-item;">Sludge dewatering</li>
                            </ul>
                        </div>
                        <div class="product-card-img" style="flex: 1; height: auto; margin-bottom: 0; background-image: url('assets/live_img_5.jpg'); background-size: cover; background-position: center;" role="img" aria-label="Frame press filter, Mambrane press filter, Drum filter, Disc filter, Leaf filter"></div>
                    </div>
                </a>

                <!-- Product 5 -->
                <a href="products.html" class="product-card">
                    <div class="product-card-img" style="background-image: url('assets/live_img_6.jpg'); background-size: cover; background-position: center;" role="img" aria-label="Belt press fitler"></div>
                    <h4>Belt Press Filter Fabric</h4>
                    <ul>
                        <li>Belt press filter</li>
                    </ul>
                    <div style="border-top: 1px solid var(--border-color); padding-top: 12px; margin-top: auto;">
                        <div style="font-size: 0.85rem; font-weight: 600; color: var(--primary-color); margin-bottom: 8px;">Applications:</div>
                        <ul style="margin: 0; padding-left: 15px; list-style-type: circle;">
                            <li style="font-size: 0.85rem; display: list-item;">Sludge dewatering</li>
                            <li style="font-size: 0.85rem; display: list-item;">Sand washing / Juice</li>
                        </ul>
                    </div>
                </a>

                <!-- Product 6 -->
                <a href="products.html" class="product-card">
                    <div class="product-card-img" style="background-image: url('assets/live_img_7.jpg'); background-size: cover; background-position: center;" role="img" aria-label="Vacuum belt dryer, Tunnel belt dryer, Belt dryer"></div>
                    <h4>Drying / Spiral Belt</h4>
                    <ul>
                        <li>Vacuum / Tunnel belt dryer</li>
                    </ul>
                    <div style="border-top: 1px solid var(--border-color); padding-top: 12px; margin-top: auto;">
                        <div style="font-size: 0.85rem; font-weight: 600; color: var(--primary-color); margin-bottom: 8px;">Applications:</div>
                        <ul style="margin: 0; padding-left: 15px; list-style-type: circle;">
                            <li style="font-size: 0.85rem; display: list-item;">Food / Medicine drying</li>
                            <li style="font-size: 0.85rem; display: list-item;">Tobacco / Electrical parts</li>
                        </ul>
                    </div>
                </a>

                <!-- Product 7 -->
                <a href="products.html" class="product-card">
                    <div class="product-card-img" style="background-image: url('assets/live_img_8.jpg'); background-size: cover; background-position: center;" role="img" aria-label="Bag filter, Dust collector"></div>
                    <h4>Dust Filter Bag</h4>
                    <ul>
                        <li>Bag filter</li>
                        <li>Dust collector</li>
                    </ul>
                    <div style="border-top: 1px solid var(--border-color); padding-top: 12px; margin-top: auto;">
                        <div style="font-size: 0.85rem; font-weight: 600; color: var(--primary-color); margin-bottom: 8px;">Applications:</div>
                        <ul style="margin: 0; padding-left: 15px; list-style-type: circle;">
                            <li style="font-size: 0.85rem; display: list-item;">Power plant</li>
                            <li style="font-size: 0.85rem; display: list-item;">Cement plant</li>
                        </ul>
                    </div>
                </a>

                <!-- Product 8 -->
                <a href="products.html" class="product-card">
                    <div class="product-card-img" style="background-image: url('assets/live_img_9.jpg'); background-size: cover; background-position: center;" role="img" aria-label="Air filtration, Water filtration, Oil filtration"></div>
                    <h4>Liquid / Air Filter Media</h4>
                    <ul>
                        <li>Air / Water / Oil filtration</li>
                    </ul>
                    <div style="border-top: 1px solid var(--border-color); padding-top: 12px; margin-top: auto;">
                        <div style="font-size: 0.85rem; font-weight: 600; color: var(--primary-color); margin-bottom: 8px;">Applications:</div>
                        <ul style="margin: 0; padding-left: 15px; list-style-type: circle;">
                            <li style="font-size: 0.85rem; display: list-item;">Air filter</li>
                            <li style="font-size: 0.85rem; display: list-item;">Water / Oil filter</li>
                        </ul>
                    </div>
                </a>
            </div>
        </div>
    </section>

    <%- include('../partials/footer') %>
</body>
</html>
